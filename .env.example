# LEANN environment variables
# Copy to .env and fill in your values:  cp .env.example .env

# --- OpenAI (LLM and optional embeddings) ---
# Required for: --llm openai, --embedding-mode openai
# Create a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: use another OpenAI-compatible API (e.g. Azure, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (optional local LLM/embeddings) ---
# Used when: --llm ollama, --embedding-mode ollama
# LEANN_OLLAMA_HOST=http://localhost:11434
